{
  "experiment_version": "v1.1.0-final",
  "dataset": {
    "total_eligible_deployments": 411137,
    "mapped_positive_labels": 13818,
    "unknown_positive_labels": 2109,
    "confirmed_negative_labels": 395210,
    "unknown_treatment": "EXCLUDED — Unknown is not Negative",
